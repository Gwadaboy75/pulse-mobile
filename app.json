{
  "expo": {
    "name": "Pulse",
    "slug": "pulse",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "in.portlabs.pulse",
      "scheme": "com.googleusercontent.apps.496401660534-p8o7nb8ai81ulvk65fh3lvue7sbl3ol6",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1113",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "in.portlabs.pulse"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 64,
          "backgroundColor": "#f6f8f9",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#101518"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "gifEnabled": false,
            "webpEnabled": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8901b7ae-3c84-4057-9ef2-613ec7c4343e"
      }
    },
    "owner": "adityajindals-team"
  }
}
